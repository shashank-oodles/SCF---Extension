    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "dotenv": "^8.2.0",
    "esbuild": "^0.24.2",
