{
  "manifest_version": 3,
  "name": "SCF — Streaming Content Filtering POC",
  "version": "1.3.0",
  "description": "Applies predefined mute and skip timestamp filters on Amazon Prime Video via a side panel picker.",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://www.primevideo.com/*",
    "https://www.amazon.com/*",
    "https://*.primevideo.com/*",
    "https://*.prime-video.amazon.dev/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/*/video/*"
      ],
      "js": ["content/primeNetworkHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/*/video/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open SCF side panel"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
