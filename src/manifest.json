{
  "manifest_version": 3,
  "name": "SCF — Streaming Content Filtering POC",
  "version": "1.0.0",
  "description": "Applies predefined mute and skip timestamp filters on Amazon Prime Video for a single POC title.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.primevideo.com/*",
    "https://www.amazon.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/*/video/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SCF POC"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
